{
  "name": "homebridge-broadlink-rm-blaster",
  "displayName": "Broadlink RM Blaster",
  "version": "1.11.6",
  "description": "Blast RF and IR signals from Broadlink RM devices using Homebridge",
  "author": "Luud Jacobs",
  "license": "MIT",
  "homepage": "https://github.com/LuudJacobs/homebridge-broadlink-rm-blaster#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuudJacobs/homebridge-broadlink-rm-blaster.git"
  },
  "bugs": {
    "url": "https://github.com/LuudJacobs/homebridge-broadlink-rm-blaster/issues"
  },
  "engines": {
    "node": "^18.15.0 || ^20.7.0 || ^22 || ^24",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "bin": {
    "broadlink-rm-blaster": "dist/cli.js",
    "broadlink-rm-learner": "dist/learner.js"
  },
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "broadlink",
    "rm4",
    "rm"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepare": "npm run build",
    "watch": "npm run build && homebridge -D",
    "lint": "eslint src test",
    "test": "node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "kiwicam-broadlinkjs-rm": "^0.9.22",
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "homebridge": "^1.8.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
