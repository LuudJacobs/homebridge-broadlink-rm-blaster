{
  "pluginAlias": "BroadlinkRMBlaster",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Blasts pre-recorded IR/RF hex signals via a Broadlink RM.",
  "schema": {
    "type": "object",
    "properties": {
      "ntfyTopic": {
        "title": "ntfy.sh Notification Topic",
        "type": "string",
        "required": false,
        "description": "If set, sends a push notification via ntfy.sh the first time an RM device fails to connect, or after 5 consecutive failed temperature/humidity readings."
      },
      "enableMqtt": {
        "title": "Enable MQTT",
        "type": "boolean",
        "default": false,
        "required": false,
        "description": "Publish temperature/humidity readings from RM devices to an MQTT broker."
      },
      "mqttHost": {
        "title": "Host",
        "type": "string",
        "default": "localhost",
        "required": false,
        "description": "Broker hostname or IP address.",
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttPort": {
        "title": "Port",
        "type": "integer",
        "default": 1883,
        "required": false,
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttUsername": {
        "title": "Username",
        "type": "string",
        "required": false,
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttPassword": {
        "title": "Password",
        "type": "string",
        "required": false,
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttBaseTopic": {
        "title": "Base Topic",
        "type": "string",
        "default": "broadlinkrm",
        "placeholder": "broadlinkrm",
        "required": false,
        "description": "Readings are published to <base topic>/<device name>. With the default base topic (broadlinkrm) a device named \"Default RM4 Pro\" publishes to \"broadlinkrm/default-rm4-pro\".",
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttRetain": {
        "title": "Retain Messages",
        "type": "boolean",
        "default": true,
        "required": false,
        "description": "Publish readings as MQTT retained messages, so a subscriber connecting later immediately gets the last known reading.",
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "rmDevices": {
        "title": "Broadlink RM Devices",
        "type": "array",
        "minItems": 1,
        "required": true,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true,
              "description": "Referenced by name from each accessory below - must be unique."
            },
            "ip": {
              "title": "IP Address",
              "type": "string",
              "format": "ipv4",
              "required": true
            },
            "enableTemperatureHumidity": {
              "title": "HomeKit thermometer accessory",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Exposes this device's temperature/humidity as a HomeKit thermometer accessory."
            },
            "enableMqttPublish": {
              "title": "Publish temperature and humidity to MQTT",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Requires MQTT to be enabled and configured below"
            }
          }
        }
      },
      "accessories": {
        "title": "Simple On/Off Accessories",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "accessoryType": {
              "title": "Accessory Type",
              "type": "string",
              "required": true,
              "default": "light",
              "oneOf": [
                { "title": "Light", "enum": ["light"] },
                { "title": "Switch", "enum": ["switch"] },
                { "title": "Outlet", "enum": ["outlet"] },
                { "title": "Fan", "enum": ["fan"] }
              ]
            },
            "powerOnCode": {
              "title": "Power On Signal",
              "type": "string",
              "required": true
            },
            "powerOffCode": {
              "title": "Power Off Signal (leave empty to use Power On Signal)",
              "type": "string",
              "required": false
            }
          }
        }
      },
      "advancedAccessories": {
        "title": "Advanced Accessories",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "offCode": {
              "title": "Off Signal (leave empty for an auto-resetting trigger instead of a real on/off switch)",
              "type": "string",
              "required": false
            },
            "timeoutSeconds": {
              "title": "Timeout Between Signals (seconds)",
              "type": "number",
              "minimum": 0,
              "default": 0.5,
              "required": false
            },
            "signals": {
              "title": "Signals",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "title": "Signal",
                    "type": "string",
                    "required": true
                  }
                }
              }
            }
          }
        }
      },
      "fans": {
        "title": "Fans",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "pressIntervalSeconds": {
              "title": "Press Interval (seconds)",
              "type": "number",
              "minimum": 0,
              "default": 0.5,
              "required": false,
              "description": "Delay between repeated presses when stepping through levels or sending a follow-up signal."
            },
            "power": {
              "title": "Power Button",
              "type": "object",
              "required": false,
              "description": "Leave empty if the fan has no dedicated power button and is powered by a mode or by swing instead.",
              "properties": {
                "toggleCode": {
                  "title": "Power Signal (one button that toggles power)",
                  "type": "string",
                  "required": false
                },
                "onCode": {
                  "title": "Power On Signal (only if on and off are separate buttons)",
                  "type": "string",
                  "required": false
                },
                "offCode": {
                  "title": "Power Off Signal (only if on and off are separate buttons)",
                  "type": "string",
                  "required": false
                }
              }
            },
            "swing": {
              "title": "Swing",
              "type": "object",
              "required": false,
              "description": "Leave empty if this fan has no swing/oscillation function.",
              "properties": {
                "code": {
                  "title": "Swing Signal (or Swing On, if on and off are separate buttons)",
                  "type": "string",
                  "required": true
                },
                "offCode": {
                  "title": "Swing Off Signal (leave empty if the Swing Signal toggles)",
                  "type": "string",
                  "required": false
                },
                "remembersState": {
                  "title": "Fan Remembers Swing State",
                  "type": "boolean",
                  "default": false,
                  "required": false,
                  "description": "Enable if the fan keeps swinging after a power cycle on its own. When off, the swing signal is resent on power on to match what HomeKit shows."
                },
                "powersOn": {
                  "title": "Turning Swing On Powers The Fan On",
                  "type": "boolean",
                  "default": false,
                  "required": false
                },
                "powersOff": {
                  "title": "Turning Swing Off Powers The Fan Off",
                  "type": "boolean",
                  "default": false,
                  "required": false
                }
              }
            },
            "speed": {
              "title": "Speed",
              "type": "object",
              "required": true,
              "description": "The fan's own speed control, shown on the fan tile. Use kind \"onoff\" for a single-speed fan.",
              "properties": {
                "name": {
                  "title": "Name",
                  "type": "string",
                  "required": true,
                  "default": "Speed"
                },
                "kind": {
                  "title": "Type",
                  "type": "string",
                  "required": true,
                  "default": "levels",
                  "oneOf": [
                    { "title": "Levels", "enum": ["levels"] },
                    { "title": "On/Off", "enum": ["onoff"] }
                  ]
                },
                "onCode": {
                  "title": "On Signal (on/off only)",
                  "type": "string",
                  "required": false
                },
                "offCode": {
                  "title": "Off Signal (on/off only, leave empty if the On Signal toggles)",
                  "type": "string",
                  "required": false
                },
                "levelCount": {
                  "title": "Number of Levels (levels only)",
                  "type": "integer",
                  "minimum": 1,
                  "required": false,
                  "description": "Count the lowest level too, which on some fans means off (e.g. off + 1 + 2 is 3)."
                },
                "upCode": {
                  "title": "Level Up Signal (levels only, also used as the cycle button)",
                  "type": "string",
                  "required": false
                },
                "downCode": {
                  "title": "Level Down Signal (levels only, leave empty if one button cycles)",
                  "type": "string",
                  "required": false
                },
                "powersOn": {
                  "title": "Activating This Powers The Fan On",
                  "type": "boolean",
                  "default": false,
                  "required": false
                },
                "powersOff": {
                  "title": "Deactivating This Powers The Fan Off",
                  "type": "boolean",
                  "default": false,
                  "required": false
                },
                "exclusive": {
                  "title": "Exclusive Mode",
                  "type": "boolean",
                  "default": false,
                  "required": false,
                  "description": "Enable if turning this on switches the fan's other exclusive modes off (e.g. heat vs fan)."
                },
                "remembersOnReturn": {
                  "title": "Resumes Its Level On Return",
                  "type": "boolean",
                  "default": false,
                  "required": false,
                  "description": "Exclusive level modes only. When off, the press that returns to this mode also moves it a level on."
                },
                "remembersState": {
                  "title": "Fan Remembers This Setting",
                  "type": "boolean",
                  "default": false,
                  "required": false,
                  "description": "Enable if the fan restores this setting after a power cycle."
                },
                "followUp": {
                  "title": "Follow-Up Signal",
                  "type": "object",
                  "required": false,
                  "description": "An extra signal sent right after this is activated, e.g. maxing out a thermostat.",
                  "properties": {
                    "name": {
                      "title": "Name",
                      "type": "string",
                      "required": true
                    },
                    "code": {
                      "title": "Signal",
                      "type": "string",
                      "required": true
                    },
                    "pressCount": {
                      "title": "Number of Presses",
                      "type": "integer",
                      "minimum": 1,
                      "default": 1,
                      "required": true
                    },
                    "everyActivation": {
                      "title": "Send On Every Activation",
                      "type": "boolean",
                      "default": false,
                      "required": false,
                      "description": "When off, this is only sent the first time the mode is switched on after the fan is powered on. Never sent for a plain level change."
                    }
                  }
                }
              }
            },
            "modes": {
              "title": "Other Modes",
              "type": "array",
              "required": false,
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "title": "Name",
                    "type": "string",
                    "required": true,
                    "description": "E.g. \"Heat\" or \"Cooler\". Shown in the Home app as \"<fan name> <mode name>\"."
                  },
                  "kind": {
                    "title": "Type",
                    "type": "string",
                    "required": true,
                    "default": "onoff",
                    "oneOf": [
                      { "title": "On/Off", "enum": ["onoff"] },
                      { "title": "Levels", "enum": ["levels"] }
                    ]
                  },
                  "onCode": {
                    "title": "On Signal (on/off only)",
                    "type": "string",
                    "required": false
                  },
                  "offCode": {
                    "title": "Off Signal (on/off only, leave empty if the On Signal toggles)",
                    "type": "string",
                    "required": false
                  },
                  "levelCount": {
                    "title": "Number of Levels (levels only)",
                    "type": "integer",
                    "minimum": 1,
                    "required": false,
                    "description": "Count the lowest level too, which on some fans means off (e.g. off + 1 + 2 is 3)."
                  },
                  "upCode": {
                    "title": "Level Up Signal (levels only, also used as the cycle button)",
                    "type": "string",
                    "required": false
                  },
                  "downCode": {
                    "title": "Level Down Signal (levels only, leave empty if one button cycles)",
                    "type": "string",
                    "required": false
                  },
                  "exposeAsSlider": {
                    "title": "Expose As A Slider",
                    "type": "boolean",
                    "default": false,
                    "required": false,
                    "description": "Levels only. When off, this shows up as a plain switch: on goes to the top level, off to the lowest."
                  },
                  "powersOn": {
                    "title": "Activating This Powers The Fan On",
                    "type": "boolean",
                    "default": false,
                    "required": false
                  },
                  "powersOff": {
                    "title": "Deactivating This Powers The Fan Off",
                    "type": "boolean",
                    "default": false,
                    "required": false
                  },
                  "exclusive": {
                    "title": "Exclusive Mode",
                    "type": "boolean",
                    "default": false,
                    "required": false,
                    "description": "Enable if turning this on switches the fan's other exclusive modes off (e.g. heat vs fan)."
                  },
                  "remembersOnReturn": {
                    "title": "Resumes Its Level On Return",
                    "type": "boolean",
                    "default": false,
                    "required": false,
                    "description": "Exclusive level modes only. When off, the press that returns to this mode also moves it a level on."
                  },
                  "remembersState": {
                    "title": "Fan Remembers This Setting",
                    "type": "boolean",
                    "default": false,
                    "required": false,
                    "description": "Enable if the fan restores this setting after a power cycle."
                  },
                  "followUp": {
                    "title": "Follow-Up Signal",
                    "type": "object",
                    "required": false,
                    "description": "An extra signal sent right after this mode is activated, e.g. maxing out a thermostat.",
                    "properties": {
                      "name": {
                        "title": "Name",
                        "type": "string",
                        "required": true
                      },
                      "code": {
                        "title": "Signal",
                        "type": "string",
                        "required": true
                      },
                      "pressCount": {
                        "title": "Number of Presses",
                        "type": "integer",
                        "minimum": 1,
                        "default": 1,
                        "required": true
                      },
                      "everyActivation": {
                        "title": "Send On Every Activation",
                        "type": "boolean",
                        "default": false,
                        "required": false,
                        "description": "When off, this is only sent the first time the mode is switched on after the fan is powered on. Never sent for a plain level change."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "dimmers": {
        "title": "Dimmer Lights",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "powerOnCode": {
              "title": "Power On Signal",
              "type": "string",
              "required": true
            },
            "powerOffCode": {
              "title": "Power Off Signal",
              "type": "string",
              "required": true
            },
            "useLastKnownBrightness": {
              "title": "Use Last Known Brightness",
              "type": "boolean",
              "required": false
            },
            "useDefaultBrightnessLevel": {
              "title": "Set Default Brightness Level",
              "type": "boolean",
              "required": false,
              "description": "Used when turning on if last-known brightness doesn't apply."
            },
            "defaultBrightnessLevel": {
              "title": "Default Brightness Level (%)",
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 50,
              "required": false,
              "condition": {
                "functionBody": "return model.dimmers && model.dimmers[arrayIndices] && model.dimmers[arrayIndices].useDefaultBrightnessLevel === true;"
              }
            },
            "useMaxBrightnessLevel": {
              "title": "Cap Maximum Brightness Level",
              "type": "boolean",
              "required": false
            },
            "maxBrightnessLevel": {
              "title": "Max Brightness Level (%)",
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 100,
              "required": false,
              "condition": {
                "functionBody": "return model.dimmers && model.dimmers[arrayIndices] && model.dimmers[arrayIndices].useMaxBrightnessLevel === true;"
              }
            },
            "zeroPercentCode": {
              "title": "Brightness 0% Signal",
              "type": "string",
              "required": true
            },
            "hundredPercentCode": {
              "title": "Brightness 100% Signal",
              "type": "string",
              "required": true
            },
            "debounceSeconds": {
              "title": "Debounce (seconds)",
              "type": "number",
              "minimum": 0,
              "default": 0.5,
              "required": false,
              "description": "Wait this long after the slider stops moving before sending a signal"
            },
            "levels": {
              "title": "Brightness Levels",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "level": {
                    "title": "Brightness Level (%)",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "required": true
                  },
                  "code": {
                    "title": "Signal",
                    "type": "string",
                    "required": true
                  }
                }
              }
            }
          }
        }
      },
      "tvs": {
        "title": "TVs",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "powerOnCode": {
              "title": "Power On Signal",
              "type": "string",
              "required": true
            },
            "powerOffCode": {
              "title": "Power Off Signal (leave empty to use Power On Signal)",
              "type": "string",
              "required": false
            },
            "volumeUpCode": {
              "title": "Volume Up Signal",
              "type": "string",
              "required": false
            },
            "volumeDownCode": {
              "title": "Volume Down Signal",
              "type": "string",
              "required": false
            },
            "muteCode": {
              "title": "Mute Signal",
              "type": "string",
              "required": false
            },
            "arrowUpCode": {
              "title": "Arrow Up Signal",
              "type": "string",
              "required": false
            },
            "arrowDownCode": {
              "title": "Arrow Down Signal",
              "type": "string",
              "required": false
            },
            "arrowLeftCode": {
              "title": "Arrow Left Signal",
              "type": "string",
              "required": false
            },
            "arrowRightCode": {
              "title": "Arrow Right Signal",
              "type": "string",
              "required": false
            },
            "selectCode": {
              "title": "Select Signal",
              "type": "string",
              "required": false
            },
            "infoCode": {
              "title": "Info Signal",
              "type": "string",
              "required": false
            },
            "backCode": {
              "title": "Back Signal",
              "type": "string",
              "required": false
            },
            "exitCode": {
              "title": "Exit Signal",
              "type": "string",
              "required": false
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "type": "array",
      "key": "rmDevices",
      "title": "Broadlink RM Devices",
      "items": [
        "rmDevices[].name",
        "rmDevices[].ip",
        "rmDevices[].enableTemperatureHumidity",
        "rmDevices[].enableMqttPublish"
      ]
    },
    {
      "type": "help",
      "helpvalue": "<div style=\"height: 1.5rem\"></div>"
    },
    {
      "type": "fieldset",
      "title": "MQTT",
      "expandable": true,
      "expanded": false,
      "items": [
        "enableMqtt",
        "mqttHost",
        "mqttPort",
        "mqttUsername",
        {
          "key": "mqttPassword",
          "type": "password"
        },
        "mqttBaseTopic",
        "mqttRetain"
      ]
    },
    {
      "type": "help",
      "helpvalue": "<div style=\"height: 1.5rem\"></div>"
    },
    {
      "type": "array",
      "key": "accessories",
      "title": "Simple On/Off Accessories",
      "expandable": true,
      "expanded": false,
      "items": [
        "accessories[].name",
        "accessories[].rmDevice",
        "accessories[].accessoryType",
        "accessories[].powerOnCode",
        "accessories[].powerOffCode"
      ]
    },
    {
      "type": "help",
      "helpvalue": "<div style=\"height: 1.5rem\"></div>"
    },
    {
      "type": "array",
      "key": "advancedAccessories",
      "title": "Advanced Accessories",
      "expandable": true,
      "expanded": false,
      "items": [
        "advancedAccessories[].name",
        "advancedAccessories[].rmDevice",
        "advancedAccessories[].offCode",
        "advancedAccessories[].timeoutSeconds",
        {
          "type": "array",
          "key": "advancedAccessories[].signals",
          "title": "Signals",
          "expandable": true,
          "expanded": false,
          "items": [
            "advancedAccessories[].signals[].code"
          ]
        }
      ]
    },
    {
      "type": "help",
      "helpvalue": "<div style=\"height: 1.5rem\"></div>"
    },
    {
      "type": "array",
      "key": "fans",
      "title": "Fans",
      "expandable": true,
      "expanded": false,
      "items": [
        "fans[].name",
        "fans[].rmDevice",
        "fans[].pressIntervalSeconds",
        {
          "type": "fieldset",
          "title": "Power Button",
          "expandable": true,
          "expanded": false,
          "items": [
            "fans[].power.toggleCode",
            "fans[].power.onCode",
            "fans[].power.offCode"
          ]
        },
        {
          "type": "fieldset",
          "title": "Swing",
          "expandable": true,
          "expanded": false,
          "items": [
            "fans[].swing.code",
            "fans[].swing.offCode",
            "fans[].swing.remembersState",
            "fans[].swing.powersOn",
            "fans[].swing.powersOff"
          ]
        },
        {
          "type": "fieldset",
          "title": "Speed",
          "expandable": true,
          "expanded": false,
          "items": [
            "fans[].speed.name",
            "fans[].speed.kind",
            "fans[].speed.levelCount",
            "fans[].speed.upCode",
            "fans[].speed.downCode",
            "fans[].speed.onCode",
            "fans[].speed.offCode",
            "fans[].speed.powersOn",
            "fans[].speed.powersOff",
            "fans[].speed.exclusive",
            "fans[].speed.remembersOnReturn",
            "fans[].speed.remembersState",
            "fans[].speed.followUp.name",
            "fans[].speed.followUp.code",
            "fans[].speed.followUp.pressCount",
            "fans[].speed.followUp.everyActivation"
          ]
        },
        {
          "type": "array",
          "key": "fans[].modes",
          "title": "Other Modes",
          "expandable": true,
          "expanded": false,
          "items": [
            "fans[].modes[].name",
