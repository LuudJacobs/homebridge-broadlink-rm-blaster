{
  "pluginAlias": "BroadlinkRMBlaster",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Blasts pre-recorded IR/RF hex signals via a Broadlink RM.",
  "schema": {
    "type": "object",
    "properties": {
      "ntfyTopic": {
        "title": "ntfy.sh Notification Topic",
        "type": "string",
        "required": false,
        "description": "If set, sends a push notification via ntfy.sh the first time an RM device fails to connect, or after 5 consecutive failed temperature/humidity readings."
      },
      "enableMqtt": {
        "title": "Enable MQTT",
        "type": "boolean",
        "default": false,
        "required": false,
        "description": "Publish temperature/humidity readings from RM devices to an MQTT broker."
      },
      "mqttHost": {
        "title": "Host",
        "type": "string",
        "default": "localhost",
        "required": false,
        "description": "Broker hostname or IP address.",
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttPort": {
        "title": "Port",
        "type": "integer",
        "default": 1883,
        "required": false,
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttUsername": {
        "title": "Username",
        "type": "string",
        "required": false,
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttPassword": {
        "title": "Password",
        "type": "string",
        "required": false,
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttBaseTopic": {
        "title": "Base Topic",
        "type": "string",
        "default": "broadlinkrm",
        "placeholder": "broadlinkrm",
        "required": false,
        "description": "Readings are published to the base topic followed by the device name. With the default base topic (broadlinkrm) a device named \"Default RM4 Pro\" publishes to \"broadlinkrm/default-rm4-pro\".",
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttLastSeenFormat": {
        "title": "last_seen Format",
        "type": "string",
        "required": false,
        "default": "iso8601",
        "description": "Adds a last_seen field to every MQTT publish (sensor readings and accessory state), same idea as zigbee2mqtt. Can be overridden per RM device below.",
        "oneOf": [
          {
            "title": "ISO 8601 (UTC)",
            "enum": [
              "iso8601"
            ]
          },
          {
            "title": "ISO 8601 (local time)",
            "enum": [
              "iso8601local"
            ]
          },
          {
            "title": "Epoch (ms)",
            "enum": [
              "epoch"
            ]
          },
          {
            "title": "Disabled",
            "enum": [
              "disabled"
            ]
          }
        ],
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "rmDevices": {
        "title": "Broadlink RM Devices",
        "type": "array",
        "minItems": 1,
        "required": true,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true,
              "description": "Referenced by name from each accessory below - must be unique."
            },
            "ip": {
              "title": "IP Address",
              "type": "string",
              "format": "ipv4",
              "required": true
            },
            "enableTemperatureHumidity": {
              "title": "HomeKit thermometer accessory",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Exposes this device's temperature/humidity as a HomeKit thermometer accessory."
            },
            "enableMqttPublish": {
              "title": "Publish temperature and humidity to MQTT",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Requires MQTT to be enabled and configured below"
            },
            "mqttRetain": {
              "title": "Retain sensor data messages",
              "type": "boolean",
              "default": true,
              "required": false,
              "description": "A subscriber connecting later immediately gets this device's last reading.",
              "condition": {
                "functionBody": "return model.enableMqtt === true && model.rmDevices && model.rmDevices[arrayIndices] && model.rmDevices[arrayIndices].enableMqttPublish === true;"
              }
            },
            "mqttLastSeenFormat": {
              "title": "last_seen Format Override",
              "type": "string",
              "required": false,
              "description": "Overrides the platform-wide last_seen format above, for this device's readings only. Leave unset to use the platform setting.",
              "oneOf": [
                {
                  "title": "ISO 8601 (UTC)",
                  "enum": [
                    "iso8601"
                  ]
                },
                {
                  "title": "ISO 8601 (local time)",
                  "enum": [
                    "iso8601local"
                  ]
                },
                {
                  "title": "Epoch (ms)",
                  "enum": [
                    "epoch"
                  ]
                },
                {
                  "title": "Disabled",
                  "enum": [
                    "disabled"
                  ]
                }
              ],
              "condition": {
                "functionBody": "return model.enableMqtt === true && model.rmDevices && model.rmDevices[arrayIndices] && model.rmDevices[arrayIndices].enableMqttPublish === true;"
              }
            }
          }
        }
      },
      "accessories": {
        "title": "Simple On/Off Accessories",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "accessoryType": {
              "title": "Accessory Type",
              "type": "string",
              "required": true,
              "default": "light",
              "oneOf": [
                {
                  "title": "Light",
                  "enum": [
                    "light"
                  ]
                },
                {
                  "title": "Switch",
                  "enum": [
                    "switch"
                  ]
                },
                {
                  "title": "Outlet",
                  "enum": [
                    "outlet"
                  ]
                },
                {
                  "title": "Fan",
                  "enum": [
                    "fan"
                  ]
                }
              ]
            },
            "powerOnCode": {
              "title": "Power On Signal",
              "type": "string",
              "required": true
            },
            "powerOffCode": {
              "title": "Power Off Signal (leave empty to use Power On Signal)",
              "type": "string",
              "required": false
            },
            "mqttSubscribe": {
              "title": "Control via MQTT",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Listen for commands and publish this accessory's on/off state. Requires the MQTT settings above to be enabled and filled in.",
              "condition": {
                "functionBody": "return model.enableMqtt === true;"
              }
            },
            "mqttTopic": {
              "title": "MQTT Topic",
              "type": "string",
              "required": false,
              "description": "The accessory's own part of the topic. Commands are read from the MQTT base topic followed by this and \"/set\", and its state is published to the same topic without \"/set\". Messages are JSON, for example {\"state\": \"ON\"} or {\"state\": \"OFF\"}. See the README for details.",
              "condition": {
                "functionBody": "return model.enableMqtt === true && model.accessories && model.accessories[arrayIndices] && model.accessories[arrayIndices].mqttSubscribe === true;"
              }
            },
            "mqttRetain": {
              "title": "Retain state messages",
              "type": "boolean",
              "default": true,
              "required": false,
              "description": "A subscriber connecting later immediately gets this accessory's last known state.",
              "condition": {
                "functionBody": "return model.enableMqtt === true && model.accessories && model.accessories[arrayIndices] && model.accessories[arrayIndices].mqttSubscribe === true;"
              }
            }
          }
        }
      },
      "advancedAccessories": {
        "title": "Advanced Accessories",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "offCode": {
              "title": "Off Signal (leave empty for an auto-resetting trigger instead of a real on/off switch)",
              "type": "string",
              "required": false
            },
            "timeoutSeconds": {
              "title": "Timeout Between Signals (seconds)",
              "type": "number",
              "minimum": 0,
              "default": 0.5,
              "required": false
            },
            "signals": {
              "title": "Signals",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "title": "Signal",
                    "type": "string",
                    "required": true
                  }
                }
              }
            },
            "mqttSubscribe": {
              "title": "Control via MQTT",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Listen for commands and publish this accessory's on/off state. Requires the MQTT settings above to be enabled and filled in.",
              "condition": {
                "functionBody": "return model.enableMqtt === true;"
              }
            },
            "mqttTopic": {
              "title": "MQTT Topic",
              "type": "string",
              "required": false,
              "description": "The accessory's own part of the topic. Commands are read from the MQTT base topic followed by this and \"/set\", and its state is published to the same topic without \"/set\". Messages are JSON, for example {\"state\": \"ON\"} or {\"state\": \"OFF\"}. See the README for details.",
              "condition": {
                "functionBody": "return model.enableMqtt === true && model.advancedAccessories && model.advancedAccessories[arrayIndices] && model.advancedAccessories[arrayIndices].mqttSubscribe === true;"
              }
            },
            "mqttRetain": {
              "title": "Retain state messages",
              "type": "boolean",
              "default": true,
              "required": false,
              "description": "A subscriber connecting later immediately gets this accessory's last known state.",
              "condition": {
                "functionBody": "return model.enableMqtt === true && model.advancedAccessories && model.advancedAccessories[arrayIndices] && model.advancedAccessories[arrayIndices].mqttSubscribe === true;"
              }
            }
          }
        }
      },
      "fans": {
        "title": "Fans",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "speedCount": {
              "title": "Number of Speeds",
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "required": false,
              "description": "1 means the fan has no speed control, just on/off."
            },
            "speedUpCode": {
              "title": "Speed Up Signal",
              "type": "string",
              "required": false,
              "description": "Also used as the cycle button when there is no Speed Down Signal."
            },
            "speedDownCode": {
              "title": "Speed Down Signal",
              "type": "string",
              "required": false,
              "description": "Leave empty if one button cycles through the speeds."
            },
            "speedPowersOn": {
              "title": "Speed Up Powers The Fan On",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "speedPowersOff": {
              "title": "Lowest Speed Powers The Fan Off",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Enable only if dropping to the lowest speed actually switches the fan off."
            },
            "speedResumes": {
              "title": "Fan Resumes Its Previous Speed",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "When off, the speed button is pressed once on power on to get the fan going."
            },
            "swingCode": {
              "title": "Swing Signal",
              "type": "string",
              "required": false,
              "description": "Leave empty if this fan has no swing/oscillation function."
            },
            "swingOffCode": {
              "title": "Swing Off Signal",
              "type": "string",
              "required": false,
              "description": "Leave empty if the Swing Signal toggles."
            },
            "swingRemembers": {
              "title": "Fan Still Swings After A Power Cycle",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "When off, the swing signal is resent on power on to match what HomeKit shows."
            },
            "swingPowersOn": {
              "title": "Swing On Powers The Fan On",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "swingPowersOff": {
              "title": "Swing Off Powers The Fan Off",
              "type": "boolean",
              "default": false,
              "required": false
            },
            "powerToggleCode": {
              "title": "Power Signal",
              "type": "string",
              "required": false,
              "description": "One button that toggles power. Leave empty if power on and off are separate buttons."
            },
            "powerOnCode": {
              "title": "Power On Signal",
              "type": "string",
              "required": false
            },
            "powerOffCode": {
              "title": "Power Off Signal",
              "type": "string",
              "required": false
            },
            "onFollowUpName": {
              "title": "Signal After Power On - Name",
              "type": "string",
              "required": false,
              "description": "A button that has to be pressed every time the fan is turned on, e.g. maxing out a thermostat."
            },
            "onFollowUpCode": {
              "title": "Signal After Power On",
              "type": "string",
              "required": false
            },
            "onFollowUpPressCount": {
              "title": "Signal After Power On - Number Of Presses",
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "required": false
            },
            "pressIntervalSeconds": {
              "title": "Press Interval (seconds)",
              "type": "number",
              "minimum": 0,
              "default": 0.5,
              "required": false,
              "description": "Delay between repeated presses when stepping through speeds or repeating a signal."
            },
            "modes": {
              "title": "Other On/Off Features",
              "type": "array",
              "required": false,
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "title": "Name",
                    "type": "string",
                    "required": true,
                    "description": "E.g. \"Cooling\". Shown in the Home app as the fan's name followed by this one, for example \"Bedroom Fan Cooling\"."
                  },
                  "onCode": {
                    "title": "On Signal",
                    "type": "string",
                    "required": true
                  },
                  "offCode": {
                    "title": "Off Signal",
                    "type": "string",
                    "required": false,
                    "description": "Leave empty if the On Signal toggles."
                  },
                  "powersOn": {
                    "title": "Turning It On Powers The Fan On",
                    "type": "boolean",
                    "default": false,
                    "required": false
                  },
                  "powersOff": {
                    "title": "Turning It Off Powers The Fan Off",
                    "type": "boolean",
                    "default": false,
                    "required": false
                  },
                  "remembers": {
                    "title": "Still On After A Power Cycle",
                    "type": "boolean",
                    "default": false,
                    "required": false
                  }
                }
              }
            },
            "resyncSwitch": {
              "title": "Resync Switch",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Exposes a switch that clears what the plugin thinks this fan is doing, without sending any signals. Useful after the fan has been used from its own remote."
            },
            "speedDebounceSeconds": {
              "title": "Speed Slider Debounce (seconds)",
              "type": "number",
              "minimum": 0,
              "default": 0.5,
              "required": false,
              "description": "How long to wait for the speed slider to settle before acting on it. HomeKit sends a value for every position a slider passes through while being dragged."
            },
            "swingSwitch": {
              "title": "Swing Switch",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Exposes swing on its own switch as well as the fan's built-in oscillate control. Worth enabling whenever this fan has other switches, because the Home app hides its oscillate control once an accessory is more than just a fan."
            },
            "mqttSubscribe": {
              "title": "Control via MQTT",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Listen for commands and publish this accessory's on/off state. Requires the MQTT settings above to be enabled and filled in.",
              "condition": {
                "functionBody": "return model.enableMqtt === true;"
              }
            },
            "mqttTopic": {
              "title": "MQTT Topic",
              "type": "string",
              "required": false,
              "description": "The accessory's own part of the topic. Commands are read from the MQTT base topic followed by this and \"/set\", and its state is published to the same topic without \"/set\". Messages are JSON, for example {\"state\": \"ON\", \"speed\": 100, \"swing\": \"ON\"}. See the README for details.",
              "condition": {
                "functionBody": "return model.enableMqtt === true && model.fans && model.fans[arrayIndices] && model.fans[arrayIndices].mqttSubscribe === true;"
              }
            },
            "swingOnPowerOn": {
              "title": "Swing On Power On",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Start the fan swinging whenever it is turned on, unless it is swinging already. Sent once the speed has settled."
            },
            "mqttRetain": {
              "title": "Retain state messages",
              "type": "boolean",
              "default": true,
              "required": false,
              "description": "A subscriber connecting later immediately gets this accessory's last known state.",
              "condition": {
                "functionBody": "return model.enableMqtt === true && model.fans && model.fans[arrayIndices] && model.fans[arrayIndices].mqttSubscribe === true;"
              }
            }
          }
        }
      },
      "dimmers": {
        "title": "Dimmer Lights",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "powerOnCode": {
              "title": "Power On Signal",
              "type": "string",
              "required": true
            },
            "powerOffCode": {
              "title": "Power Off Signal",
              "type": "string",
              "required": true
            },
            "useLastKnownBrightness": {
              "title": "Use Last Known Brightness",
              "type": "boolean",
              "required": false
            },
            "useDefaultBrightnessLevel": {
              "title": "Set Default Brightness Level",
              "type": "boolean",
              "required": false,
              "description": "Used when turning on if last-known brightness doesn't apply."
            },
            "defaultBrightnessLevel": {
              "title": "Default Brightness Level (%)",
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 50,
              "required": false,
              "condition": {
                "functionBody": "return model.dimmers && model.dimmers[arrayIndices] && model.dimmers[arrayIndices].useDefaultBrightnessLevel === true;"
              }
            },
            "useMaxBrightnessLevel": {
              "title": "Cap Maximum Brightness Level",
              "type": "boolean",
              "required": false
            },
            "maxBrightnessLevel": {
              "title": "Max Brightness Level (%)",
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 100,
              "required": false,
              "condition": {
                "functionBody": "return model.dimmers && model.dimmers[arrayIndices] && model.dimmers[arrayIndices].useMaxBrightnessLevel === true;"
              }
            },
            "zeroPercentCode": {
              "title": "Brightness 0% Signal",
              "type": "string",
              "required": true
            },
            "hundredPercentCode": {
              "title": "Brightness 100% Signal",
              "type": "string",
              "required": true
            },
            "debounceSeconds": {
              "title": "Debounce (seconds)",
              "type": "number",
              "minimum": 0,
              "default": 0.5,
              "required": false,
              "description": "Wait this long after the slider stops moving before sending a signal"
            },
            "levels": {
              "title": "Brightness Levels",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "level": {
                    "title": "Brightness Level (%)",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "required": true
                  },
                  "code": {
                    "title": "Signal",
                    "type": "string",
                    "required": true
                  }
                }
              }
            },
            "mqttSubscribe": {
              "title": "Control via MQTT",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Listen for commands and publish this accessory's on/off state. Requires the MQTT settings above to be enabled and filled in.",
              "condition": {
                "functionBody": "return model.enableMqtt === true;"
              }
            },
            "mqttTopic": {
              "title": "MQTT Topic",
              "type": "string",
              "required": false,
              "description": "The accessory's own part of the topic. Commands are read from the MQTT base topic followed by this and \"/set\", and its state is published to the same topic without \"/set\". Messages are JSON, for example {\"state\": \"ON\", \"level\": 50} - level is a percentage. See the README for details.",
              "condition": {
                "functionBody": "return model.enableMqtt === true && model.dimmers && model.dimmers[arrayIndices] && model.dimmers[arrayIndices].mqttSubscribe === true;"
              }
            },
            "mqttRetain": {
              "title": "Retain state messages",
              "type": "boolean",
              "default": true,
              "required": false,
              "description": "A subscriber connecting later immediately gets this accessory's last known state.",
              "condition": {
                "functionBody": "return model.enableMqtt === true && model.dimmers && model.dimmers[arrayIndices] && model.dimmers[arrayIndices].mqttSubscribe === true;"
              }
            }
          }
        }
      },
      "tvs": {
        "title": "TVs",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "powerOnCode": {
              "title": "Power On Signal",
              "type": "string",
              "required": true
            },
            "powerOffCode": {
              "title": "Power Off Signal (leave empty to use Power On Signal)",
              "type": "string",
              "required": false
            },
            "volumeUpCode": {
              "title": "Volume Up Signal",
              "type": "string",
              "required": false
            },
            "volumeDownCode": {
              "title": "Volume Down Signal",
              "type": "string",
              "required": false
            },
            "muteCode": {
              "title": "Mute Signal",
              "type": "string",
              "required": false
            },
            "arrowUpCode": {
              "title": "Arrow Up Signal",
              "type": "string",
              "required": false
            },
            "arrowDownCode": {
              "title": "Arrow Down Signal",
              "type": "string",
              "required": false
            },
            "arrowLeftCode": {
              "title": "Arrow Left Signal",
              "type": "string",
              "required": false
            },
            "arrowRightCode": {
              "title": "Arrow Right Signal",
              "type": "string",
              "required": false
            },
            "selectCode": {
              "title": "Select Signal",
              "type": "string",
              "required": false
            },
            "infoCode": {
              "title": "Info Signal",
              "type": "string",
              "required": false
            },
            "backCode": {
              "title": "Back Signal",
              "type": "string",
              "required": false
            },
            "exitCode": {
              "title": "Exit Signal",
              "type": "string",
              "required": false
            },
            "mqttSubscribe": {
              "title": "Control via MQTT",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Listen for commands and publish this accessory's on/off state. Requires the MQTT settings above to be enabled and filled in.",
              "condition": {
                "functionBody": "return model.enableMqtt === true;"
              }
            },
            "mqttTopic": {
              "title": "MQTT Topic",
              "type": "string",
              "required": false,
              "description": "The accessory's own part of the topic. Commands are read from the MQTT base topic followed by this and \"/set\", and its state is published to the same topic without \"/set\". Messages are JSON, for example {\"state\": \"ON\"} or {\"state\": \"OFF\"}. See the README for details.",
              "condition": {
                "functionBody": "return model.enableMqtt === true && model.tvs && model.tvs[arrayIndices] && model.tvs[arrayIndices].mqttSubscribe === true;"
              }
            },
            "mqttRetain": {
              "title": "Retain state messages",
              "type": "boolean",
              "default": true,
              "required": false,
              "description": "A subscriber connecting later immediately gets this accessory's last known state.",
              "condition": {
                "functionBody": "return model.enableMqtt === true && model.tvs && model.tvs[arrayIndices] && model.tvs[arrayIndices].mqttSubscribe === true;"
              }
            }
          }
        }
      }
    }
  },
