{
  "pluginAlias": "BroadlinkRMBlaster",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Blasts pre-recorded IR/RF hex signals via a Broadlink RM.",
  "schema": {
    "type": "object",
    "properties": {
      "ntfyTopic": {
        "title": "ntfy.sh Notification Topic",
        "type": "string",
        "required": false,
        "description": "If set, sends a push notification via ntfy.sh the first time an RM device fails to connect, or after 5 consecutive failed temperature/humidity readings."
      },
      "enableMqtt": {
        "title": "Enable MQTT",
        "type": "boolean",
        "default": false,
        "required": false,
        "description": "Publish temperature/humidity readings from RM devices to an MQTT broker."
      },
      "mqttHost": {
        "title": "Host",
        "type": "string",
        "default": "localhost",
        "required": false,
        "description": "Broker hostname or IP address.",
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttPort": {
        "title": "Port",
        "type": "integer",
        "default": 1883,
        "required": false,
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttUsername": {
        "title": "Username",
        "type": "string",
        "required": false,
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttPassword": {
        "title": "Password",
        "type": "string",
        "required": false,
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttBaseTopic": {
        "title": "Base Topic",
        "type": "string",
        "default": "broadlinkrm",
        "placeholder": "broadlinkrm",
        "required": false,
        "description": "Readings are published to <base topic>/<device name>. With the default base topic (broadlinkrm) a device named \"Default RM4 Pro\" publishes to \"broadlinkrm/default-rm4-pro\".",
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "mqttRetain": {
        "title": "Retain Messages",
        "type": "boolean",
        "default": true,
        "required": false,
        "description": "Publish readings as MQTT retained messages, so a subscriber connecting later immediately gets the last known reading.",
        "condition": {
          "functionBody": "return model.enableMqtt === true;"
        }
      },
      "rmDevices": {
        "title": "Broadlink RM Devices",
        "type": "array",
        "minItems": 1,
        "required": true,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true,
              "description": "Referenced by name from each accessory below - must be unique."
            },
            "ip": {
              "title": "IP Address",
              "type": "string",
              "format": "ipv4",
              "required": true
            },
            "enableTemperatureHumidity": {
              "title": "HomeKit thermometer accessory",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Exposes this device's temperature/humidity as a HomeKit thermometer accessory."
            },
            "enableMqttPublish": {
              "title": "Publish temperature and humidity to MQTT",
              "type": "boolean",
              "default": false,
              "required": false,
              "description": "Requires MQTT to be enabled and configured below"
            }
          }
        }
      },
      "accessories": {
        "title": "Basic Accessories",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "accessoryType": {
              "title": "Accessory Type",
              "type": "string",
              "required": true,
              "default": "light",
              "oneOf": [
                { "title": "Light", "enum": ["light"] },
                { "title": "Switch", "enum": ["switch"] },
                { "title": "Outlet", "enum": ["outlet"] },
                { "title": "Fan", "enum": ["fan"] }
              ]
            },
            "powerOnCode": {
              "title": "Power On Signal",
              "type": "string",
              "required": true
            },
            "powerOffCode": {
              "title": "Power Off Signal (leave empty to use Power On Signal)",
              "type": "string",
              "required": false
            }
          }
        }
      },
      "advancedAccessories": {
        "title": "Advanced Accessories",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "offCode": {
              "title": "Off Signal (leave empty for an auto-resetting trigger instead of a real on/off switch)",
              "type": "string",
              "required": false
            },
            "timeoutSeconds": {
              "title": "Timeout Between Signals (seconds)",
              "type": "number",
              "minimum": 0,
              "default": 0.5,
              "required": false
            },
            "signals": {
              "title": "Signals",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "title": "Signal",
                    "type": "string",
                    "required": true
                  }
                }
              }
            }
          }
        }
      },
      "dimmers": {
        "title": "Dimmer Lights",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "powerOnCode": {
              "title": "Power On Signal",
              "type": "string",
              "required": true
            },
            "powerOffCode": {
              "title": "Power Off Signal",
              "type": "string",
              "required": true
            },
            "useLastKnownBrightness": {
              "title": "Use Last Known Brightness",
              "type": "boolean",
              "required": false
            },
            "useDefaultBrightnessLevel": {
              "title": "Set Default Brightness Level",
              "type": "boolean",
              "required": false,
              "description": "Used when turning on if last-known brightness doesn't apply."
            },
            "defaultBrightnessLevel": {
              "title": "Default Brightness Level (%)",
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 50,
              "required": false,
              "condition": {
                "functionBody": "return model.dimmers && model.dimmers[arrayIndices] && model.dimmers[arrayIndices].useDefaultBrightnessLevel === true;"
              }
            },
            "useMaxBrightnessLevel": {
              "title": "Cap Maximum Brightness Level",
              "type": "boolean",
              "required": false
            },
            "maxBrightnessLevel": {
              "title": "Max Brightness Level (%)",
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 100,
              "required": false,
              "condition": {
                "functionBody": "return model.dimmers && model.dimmers[arrayIndices] && model.dimmers[arrayIndices].useMaxBrightnessLevel === true;"
              }
            },
            "zeroPercentCode": {
              "title": "Brightness 0% Signal",
              "type": "string",
              "required": true
            },
            "hundredPercentCode": {
              "title": "Brightness 100% Signal",
              "type": "string",
              "required": true
            },
            "debounceSeconds": {
              "title": "Debounce (seconds)",
              "type": "number",
              "minimum": 0,
              "default": 0.5,
              "required": false,
              "description": "Wait this long after the slider stops moving before sending a signal"
            },
            "levels": {
              "title": "Brightness Levels",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "level": {
                    "title": "Brightness Level (%)",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "required": true
                  },
                  "code": {
                    "title": "Signal",
                    "type": "string",
                    "required": true
                  }
                }
              }
            }
          }
        }
      },
      "tvs": {
        "title": "TVs",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "rmDevice": {
              "title": "RM Device",
              "type": "string",
              "required": true,
              "description": "Must match the name of one of the configured RM devices exactly."
            },
            "powerOnCode": {
              "title": "Power On Signal",
              "type": "string",
              "required": true
            },
            "powerOffCode": {
              "title": "Power Off Signal (leave empty to use Power On Signal)",
              "type": "string",
              "required": false
            },
            "volumeUpCode": {
              "title": "Volume Up Signal",
              "type": "string",
              "required": false
            },
            "volumeDownCode": {
              "title": "Volume Down Signal",
              "type": "string",
              "required": false
            },
            "muteCode": {
              "title": "Mute Signal",
              "type": "string",
              "required": false
            },
            "arrowUpCode": {
              "title": "Arrow Up Signal",
              "type": "string",
              "required": false
            },
            "arrowDownCode": {
              "title": "Arrow Down Signal",
              "type": "string",
              "required": false
            },
            "arrowLeftCode": {
              "title": "Arrow Left Signal",
              "type": "string",
              "required": false
            },
            "arrowRightCode": {
              "title": "Arrow Right Signal",
              "type": "string",
              "required": false
            },
            "selectCode": {
              "title": "Select Signal",
              "type": "string",
              "required": false
            },
            "infoCode": {
              "title": "Info Signal",
              "type": "string",
              "required": false
            },
            "backCode": {
              "title": "Back Signal",
              "type": "string",
              "required": false
            },
            "exitCode": {
              "title": "Exit Signal",
              "type": "string",
              "required": false
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "type": "array",
      "key": "rmDevices",
      "title": "Broadlink RM Devices",
      "items": [
        "rmDevices[].name",
        "rmDevices[].ip",
        "rmDevices[].enableTemperatureHumidity",
        "rmDevices[].enableMqttPublish"
      ]
    },
    {
      "type": "help",
      "helpvalue": "<div style=\"height: 1.5rem\"></div>"
    },
    {
      "type": "fieldset",
      "title": "MQTT",
      "expandable": true,
      "expanded": false,
      "items": [
        "enableMqtt",
        "mqttHost",
        "mqttPort",
        "mqttUsername",
        {
          "key": "mqttPassword",
          "type": "password"
        },
        "mqttBaseTopic",
        "mqttRetain"
      ]
    },
    {
      "type": "help",
      "helpvalue": "<div style=\"height: 1.5rem\"></div>"
    },
    {
      "type": "array",
      "key": "accessories",
      "title": "Basic Accessories",
      "expandable": true,
      "expanded": false,
      "items": [
        "accessories[].name",
        "accessories[].rmDevice",
        "accessories[].accessoryType",
        "accessories[].powerOnCode",
        "accessories[].powerOffCode"
      ]
    },
    {
      "type": "help",
      "helpvalue": "<div style=\"height: 1.5rem\"></div>"
    },
    {
      "type": "array",
      "key": "advancedAccessories",
      "title": "Advanced Accessories",
      "expandable": true,
      "expanded": false,
      "items": [
        "advancedAccessories[].name",
        "advancedAccessories[].rmDevice",
        "advancedAccessories[].offCode",
        "advancedAccessories[].timeoutSeconds",
        {
          "type": "array",
          "key": "advancedAccessories[].signals",
          "title": "Signals",
          "expandable": true,
          "expanded": false,
          "items": [
            "advancedAccessories[].signals[].code"
          ]
        }
      ]
    },
    {
      "type": "help",
      "helpvalue": "<div style=\"height: 1.5rem\"></div>"
    },
    {
      "type": "array",
      "key": "dimmers",
      "title": "Dimmer Lights",
      "expandable": true,
      "expanded": false,
      "items": [
        "dimmers[].name",
        "dimmers[].rmDevice",
        "dimmers[].powerOnCode",
        "dimmers[].powerOffCode",
        "dimmers[].useLastKnownBrightness",
        "dimmers[].useDefaultBrightnessLevel",
        "dimmers[].defaultBrightnessLevel",
        "dimmers[].useMaxBrightnessLevel",
        "dimmers[].maxBrightnessLevel",
        "dimmers[].zeroPercentCode",
        "dimmers[].hundredPercentCode",
        "dimmers[].debounceSeconds",
        {
          "type": "array",
          "key": "dimmers[].levels",
          "title": "Brightness Levels",
          "expandable": true,
          "expanded": false,
          "items": [
            "dimmers[].levels[].level",
            "dimmers[].levels[].code"
          ]
        }
      ]
    },
    {
      "type": "help",
      "helpvalue": "<div style=\"height: 1.5rem\"></div>"
    },
    {
      "type": "array",
      "key": "tvs",
      "title": "TVs",
      "expandable": true,
      "expanded": false,
      "items": [
        "tvs[].name",
        "tvs[].rmDevice",
        "tvs[].powerOnCode",
        "tvs[].powerOffCode",
        "tvs[].volumeUpCode",
        "tvs[].volumeDownCode",
        "tvs[].muteCode",
        "tvs[].arrowUpCode",
        "tvs[].arrowDownCode",
        "tvs[].arrowLeftCode",
        "tvs[].arrowRightCode",
        "tvs[].selectCode",
        "tvs[].infoCode",
        "tvs[].backCode",
        "tvs[].exitCode"
      ]
    },
    {
      "type": "help",
      "helpvalue": "<div style=\"height: 1.5rem\"></div>"
    },
    {
      "type": "fieldset",
      "title": "Notifications",
      "expandable": true,
      "expanded": true,
      "items": [
        "ntfyTopic"
      ]
    }
  ]
}
